---
import catalogue from '../generated/catalogue.json';
import { recommend } from '../lib/recommendations';
import { gallery } from '../lib/gallery';
import type { Product } from '../lib/product';
import config from '../../data/discovery.json';
const { productId = '', modal = false } = Astro.props;
const items = config.enabled ? recommend(catalogue.products as Product[], productId) : [];
---

<section
  class="related-products"
  data-recommendations
  data-source-product={productId}
  data-placement={modal ? 'product_modal' : 'product_detail'}
  hidden={!items.length}
  aria-label="More to explore"
>
  <h3>More to explore</h3>
  <p>Little discoveries from our collection.</p>
  <div class="related-list">
    {items.map(({ product, reason }) => (
      <a class="related-item" href={`/products/${product.slug}/`}>
        <img
          src={gallery(product)[0].src}
          alt=""
          width="64"
          height="76"
          loading="lazy"
          data-fallback={gallery(product)[0].fallback}
        />
        <span>
          <strong>{product.name}</strong>
          <small>{reason}</small>
        </span>
      </a>
    ))}
  </div>
</section>
