---
import ProductCard from './ProductCard.astro';
import catalogue from '../generated/catalogue.json';
import taxonomy from '../../data/taxonomy.json';
import type { Product } from '../lib/product';
import { ageStages } from '../lib/age-stage';
const { initialCategory = '' } = Astro.props;
---

<section
  class="catalogue"
  id="collection"
  aria-label="Product collection"
  data-category-id={initialCategory}
>
  <div class="collection-heading">
    <div>
      <p class="showcase-kicker">
        <span></span> The everyday edit
      </p>
      <h2>
        Small things.
        <br />
        <em>Big comfort.</em>
      </h2>
    </div>
    <p>
      Seven easy essentials, selected for the tiny moments that fill a day. Search naturally or take
      your time and browse.
    </p>
  </div>
  <div class="search-band">
    <form id="search-form" role="search">
      <label for="query" class="sr-only">
        Search products
      </label>
      <span aria-hidden="true" class="search-icon">
        ⌕
      </span>
      <input
        id="query"
        name="q"
        type="search"
        maxlength="200"
        placeholder="What are you looking for? Try “pink baby caps”"
        autocomplete="off"
      />
      <button type="submit" class="button">
        Find it <span aria-hidden="true">↗</span>
      </button>
      <p id="search-mode">Search by product, colour, material, or budget.</p>
    </form>
  </div>
  <div class="collection-toolbar" id="results-refinement">
    <p class="refinement-label">Shape your edit</p>
    <div class="sort-controls">
      <label for="age-stage" class="sr-only">Age stage</label>
      <select id="age-stage">
        <option value="">All ages · verify suitability</option>
        {ageStages.map((stage) => <option value={stage.id}>{stage.label}</option>)}
      </select>
      <label for="category-filter" class="sr-only">
        Category
      </label>
      <select id="category-filter">
        <option value="">Every category</option>
        {taxonomy.map((t) => (
          <option value={t.id} selected={t.id === initialCategory}>
            {t.name}
          </option>
        ))}
      </select>
      <label for="budget" class="sr-only">
        Maximum price
      </label>
      <select id="budget">
        <option value="">Any budget</option>
        <option value="150">Up to ₹150</option>
        <option value="200">Up to ₹200</option>
        <option value="500">Up to ₹500</option>
        <option value="800">Up to ₹800</option>
        <option value="1000">Up to ₹1,000</option>
      </select>
      <label for="sort" class="sr-only">
        Sort products
      </label>
      <select id="sort">
        <option value="relevance">Recommended order</option>
        <option value="price-low">Price: low to high</option>
        <option value="price-high">Price: high to low</option>
        <option value="newest">Newest first</option>
      </select>
    </div>
  </div>
  <div class="results-meta">
    <span id="result-count" role="status">
      {
        catalogue.products.filter((p) => !initialCategory || p.category_id === initialCategory)
          .length
      }{' '}
      thoughtful finds
    </span>
    <button id="clear-filters" class="text-button" hidden>
      Clear filters
    </button>
  </div>
  <p id="interpreted" class="interpreted" hidden></p>
  <div id="product-grid" class="product-grid">
    {catalogue.products.map((product) => (
      <ProductCard
        product={product as Product}
        hidden={Boolean(initialCategory && product.category_id !== initialCategory)}
      />
    ))}
  </div>
  <div id="empty" class="empty" hidden>
    <p class="eyebrow">A LITTLE TOO SPECIFIC?</p>
    <h2>No finds this time.</h2>
    <p>Try another word or a wider budget. Age filters include only products with verified suitability covering that whole stage. Unverified products are excluded.</p>
    <button class="button secondary" id="reset-search">
      Explore all products
    </button>
  </div>
</section>

<script>
  import '../scripts/storefront';
</script>
