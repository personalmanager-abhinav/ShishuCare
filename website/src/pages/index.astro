---
import Layout from '../layouts/Layout.astro';
import Catalogue from '../components/Catalogue.astro';
---

<Layout>
  <Catalogue />
  <section class="buy-strip">
    <span class="eyebrow">ONE PRODUCT. YOUR CHOICE.</span>
    <h2>
      Find it here.
      <br />
      Make it yours, over there.
    </h2>
    <div>
      <p>
        Take a closer look, then choose Meesho, Amazon, or Flipkart. Your order, payment, and
        delivery stay with the marketplace you trust.
      </p>
      <a href="/about/">How it works ↗</a>
    </div>
  </section>
</Layout>
